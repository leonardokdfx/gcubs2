# String de conexão do MongoDB (Atlas ou outro provedor)
MONGO_URI=mongodb+srv://usuario:senha@seu-cluster.mongodb.net/nome-do-banco?retryWrites=true&w=majority

# Chave secreta para assinar os tokens JWT.
# Gere uma com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_por_uma_chave_aleatoria_longa
